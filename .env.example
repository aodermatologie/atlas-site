# Copiez ce fichier en .env (jamais dans Git) et remplissez-le.
# En production, saisissez ces variables dans la console de l'hébergeur.

# ── Site ─────────────────────────────────────────────────────────────
SITE_URL=https://aodermatologie.org
PORT=8080
# Nombre de proxys de l'hébergeur devant le serveur (1 chez Clever Cloud). 0 en local.
TRUST_PROXY=0

# ── Coffre-fort ──────────────────────────────────────────────────────
# Empreinte du code, produite par : npm run coffre:hacher -- "VOTRE CODE"
COFFRE_CODE_EMPREINTE=
# Au moins 32 caractères aléatoires (la commande ci-dessus en propose un).
SESSION_SECRET=
# Augmentez ce nombre après un changement de code : toutes les sessions ouvertes se ferment.
COFFRE_VERSION=1
# false uniquement en local (http://localhost). Toujours true en production (https).
COOKIE_SECURE=true

# ── Photos ───────────────────────────────────────────────────────────
# local : dossier stockage-local/ (développement) · s3 : buckets de l'hébergeur (production)
STOCKAGE=local
STOCKAGE_LOCAL=./stockage-local

# Adresse publique des photos libres. Vide en local (/medias). En production, l'adresse du bucket public,
# par exemple https://aod-photos-publiques.cellar-c2.services.clever-cloud.com — lue au moment de la construction.
PUBLIC_MEDIA_URL=

# Stockage S3. Chez Clever Cloud, reliez l'add-on Cellar à l'application : il fournit CELLAR_ADDON_HOST,
# CELLAR_ADDON_KEY_ID et CELLAR_ADDON_KEY_SECRET, utilisés automatiquement. Pour un autre hébergeur : S3_ENDPOINT,
# S3_ACCESS_KEY, S3_SECRET_KEY (et S3_REGION si besoin).
CELLAR_ADDON_HOST=
CELLAR_ADDON_KEY_ID=
CELLAR_ADDON_KEY_SECRET=
# Bucket public : photos libres et floutées, lisibles par tous.
S3_BUCKET_PUBLIC=aod-photos-publiques
# Bucket privé : photos verrouillées, lues uniquement par le serveur.
S3_BUCKET_PRIVE=aod-photos-privees
